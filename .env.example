# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
MAX_CONCURRENT_CALLS_PER_USER=2

# ── AI Services ───────────────────────────────────────────────────────────────
# GOOGLE_API_KEY=your-google-gemini-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
CARTESIA_API_KEY=your-cartesia-api-key
# OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# ── Model Config ──────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# ── Cost Rates (USD) ──────────────────────────────────────────────────────────
GROQ_INPUT_COST_PER_1K_TOKENS=0.0
GROQ_OUTPUT_COST_PER_1K_TOKENS=0.0
OPENAI_INPUT_COST_PER_1K_TOKENS=0.00015
OPENAI_OUTPUT_COST_PER_1K_TOKENS=0.0006
GEMINI_INPUT_COST_PER_1K_TOKENS=0.000075
GEMINI_OUTPUT_COST_PER_1K_TOKENS=0.0003
DEEPGRAM_COST_PER_SECOND=0.0001
CARTESIA_COST_PER_1K_CHARS=0.09
